{
  "name": "react-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"tests/**/*.js\" index.html .github/workflows/ci.yml",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\" \"tests/**/*.js\" index.html .github/workflows/ci.yml"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "vite": "^7.3.0"
  }
}
